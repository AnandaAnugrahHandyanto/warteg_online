<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="@android:color/white">

    <TextView
        android:id="@+id/tv_judul_const"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="IMPLEMENTASI CONSTRAINT LAYOUT"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_gray"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_desc_const"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Constraint Layout merupakan layout dengan tata letak komponen secara bebas (tanpa aturan orientasi seperti horizontal dan vertikal pada Linear Layout). Setiap view memiliki constraint (tali) yang menarik setiap sisi dari layoutnya yang secara fleksibel (margin dll)."
        android:textSize="14sp"
        android:textColor="@color/text_gray"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tv_judul_const"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btn_ok_const"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="OK"
        android:backgroundTint="@color/blue_button"
        android:textColor="@color/white"
        android:textAllCaps="false"
        app:layout_constraintTop_toBottomOf="@id/tv_desc_const"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintEnd_toStartOf="@+id/btn_cancel_const"
        android:layout_marginEnd="10dp"
        android:minWidth="120dp" />

    <Button
        android:id="@+id/btn_cancel_const"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CANCEL"
        android:backgroundTint="@color/red_cancel"
        android:textColor="@color/white"
        android:textAllCaps="false"
        app:layout_constraintTop_toTopOf="@+id/btn_ok_const"
        app:layout_constraintStart_toEndOf="@+id/btn_ok_const"
        app:layout_constraintEnd_toEndOf="parent"
        android:minWidth="120dp" />

</androidx.constraintlayout.widget.ConstraintLayout>