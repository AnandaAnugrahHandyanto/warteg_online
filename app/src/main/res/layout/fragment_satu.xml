<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:gravity="center"
                    android:text="PROFIL USAHA"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="10dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/warteg_online" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="Masukan Nama Usaha Anda"
                    android:textColor="@android:color/black" />

                <EditText
                    android:id="@+id/nama_usaha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Masukan Nama Usaha"
                    android:inputType="text"
                    android:minHeight="48dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="Menu Makanan Usaha Anda"
                    android:textColor="@android:color/black" />

                <CheckBox
                    android:id="@+id/soto_ayam"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Soto Ayam" />

                <CheckBox
                    android:id="@+id/nasi_pecel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nasi Pecel" />

                <CheckBox
                    android:id="@+id/nasi_rames"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nasi Rames" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="Status Usaha Anda"
                    android:textColor="@android:color/black" />

                <ToggleButton
                    android:id="@+id/status_usaha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textOff="Tidak Aktif"
                    android:textOn="Aktif" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="Status Promo"
                    android:textColor="@android:color/black" />

                <Switch
                    android:id="@+id/status_promo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:minHeight="48dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="Kategori Usaha"
                    android:textColor="@android:color/black" />

                <RadioGroup
                    android:id="@+id/kategori_usaha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <RadioButton
                        android:id="@+id/rb_kecil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Kecil" />

                    <RadioButton
                        android:id="@+id/rb_menengah"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Menengah" />

                    <RadioButton
                        android:id="@+id/rb_besar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Besar" />
                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="Waktu Buka"
                    android:textColor="@android:color/black" />

                <TimePicker
                    android:id="@+id/waktu_buka"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:timePickerMode="spinner" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="Waktu Promo Utama"
                    android:textColor="@android:color/black" />

                <DatePicker
                    android:id="@+id/waktu_promo_utama"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:datePickerMode="calendar" />

                <Button
                    android:id="@+id/submit"
                    style="@style/button_OK_Biru"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="OK" />

                <TextView
                    android:id="@+id/review"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="30dp"
                    android:text="Review Profile Usaha"
                    android:textColor="@android:color/black"
                    android:textSize="16sp" />

            </LinearLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>