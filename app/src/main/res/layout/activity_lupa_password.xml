<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="30dp"
    android:paddingTop="50dp"
    tools:context=".LupaPasswordActivity">

    <ImageView
        android:id="@+id/img_logo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/lupa_password"
        tools:ignore="ContentDescription"
        tools:srcCompat="@drawable/lupa_password" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Kesulitan Login?"
        android:textAlignment="center"
        android:textColor="#000000"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Masukkan email Anda dan kami akan mengirimkan tautan untuk kembali ke akun Anda."
        android:textAlignment="center"
        android:textColor="#333333"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/et_email_reset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="Masukkan Email Anda"
        android:inputType="textEmailAddress"
        android:maxWidth="488dp"
        android:minHeight="48dp" />

    <Button
        android:id="@+id/btn_kirim_tautan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="#1FDFF1"
        android:maxWidth="488dp"
        android:minHeight="48dp"
        android:text="Kirim Tautan Masuk"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tv_footer_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Jika tidak bisa mengatur ulang kata sandi, Anda akan diarahkan ke browser untuk bantuan lebih lanjut."
        android:textAlignment="center"
        android:textColor="#666666"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btn_bantuan_browser"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Buka Bantuan di Browser"
        android:textColor="#2F56C8"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btn_kembali"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Kembali ke Login"
        android:textColor="#666666"
        android:textSize="14sp" />

</LinearLayout>
